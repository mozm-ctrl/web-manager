{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the local sidebar UI (webview \"main\") may call commands; account webviews load remote sites and get no IPC access.",
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-theme",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:allow-restart"
  ],
  "webviews": [
    "main"
  ]
}
