{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Manager",
  "version": "0.8.2",
  "identifier": "com.mozm.webmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "网页管理器",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QUNBRTM3ODU2MTY5RDgKUldUWWFXR0ZONjZzWklqTTlPd1pueEk5clRVbkhQcll6b2c2b2NFYlZGMlBqSEFyM09BR2FPWTcK",
      "endpoints": [
        "https://github.com/mozm-ctrl/web-manager/releases/latest/download/latest.json"
      ]
    }
  }
}